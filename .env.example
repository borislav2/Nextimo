# PostgreSQL connection (Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/nextimo?schema=public"

# Long random string used to sign admin sessions: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Public URL of the site (used for sitemap and links)
NEXT_PUBLIC_SITE_URL="https://nextimo.bg"

# Folder where uploaded property photos are stored (must persist between deploys)
UPLOAD_DIR="./uploads"

# Server time zone (viewing calendar works in Plovdiv time)
TZ="Europe/Sofia"

# First admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@nextimo.bg"
SEED_ADMIN_PASSWORD="ChangeMe123!"
